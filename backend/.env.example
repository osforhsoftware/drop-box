MONGO_URL=mongodb://localhost:27017
DB_NAME=drop_box
JWT_SECRET=change_me_to_a_long_random_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password
FRONTEND_URL=http://localhost:3000

# Customer Google Sign-In (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
# Optional — only used by seed scripts. API returns relative /api/uploads/... paths.
# PUBLIC_BASE_URL=http://localhost:8000
PORT=8000
HOST=localhost
# Security (optional — see backend/lib/security.js)
# CORS_ORIGINS=http://localhost:3000
# DISABLE_BOT_PROTECTION=true
# DISABLE_RATE_LIMIT=true
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MS=300000
# LOGIN_PAIR_WINDOW_MS=900000

