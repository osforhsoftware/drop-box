# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=drop_box
JWT_SECRET=replace_with_long_random_secret_32plus_chars
ADMIN_EMAIL=admin@caseboxstore.com
ADMIN_PASSWORD=replace_with_strong_password

# Server (VPS — backend only)
NODE_ENV=production
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://145-223-23-47.sslip.io
CORS_ORIGINS=https://caseboxstore.com,https://www.caseboxstore.com
FRONTEND_URL=https://caseboxstore.com

# Customer Google Sign-In (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://145-223-23-47.sslip.io/api/auth/google/callback

# Security (optional — see backend/lib/security.js)
# DISABLE_BOT_PROTECTION=true
# DISABLE_RATE_LIMIT=true
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MS=300000
# LOGIN_PAIR_WINDOW_MS=900000

# Razorpay (set on server only — never commit real keys)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# --- LOCAL DEVELOPMENT (uncomment and comment production block above) ---
# NODE_ENV=development
# HOST=localhost
# PORT=8000
# PUBLIC_BASE_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
